From 61705f27c7d1473d694ac13ebc85ac3621fd9149 Mon Sep 17 00:00:00 2001
From: Rob Heaton <rob@northwestlinux.co.uk>
Date: Tue, 29 Sep 2026 20:42:25 +0100
Subject: [PATCH 3/5] USB3: compute the SS route string for devices behind
 external hubs

xhci_new_device_common() passed a hardcoded route string of 0 to
xhci_init_slot(), which is only right for a device attached directly to a
root port. Build the real Route String (xHCI spec 4.3.3): the downstream
port number at each hub tier below the root, tier 1 in the least
significant nibble, up to 5 tiers. Only used for SuperSpeed devices;
everything else still gets 0.

Untested on hardware: needs a SuperSpeed hub with a device behind it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 c/xhci | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/c/xhci b/c/xhci
index 446571a..4d1e33d 100644
--- a/c/xhci
+++ b/c/xhci
@@ -1908,6 +1908,36 @@ xhci_get_lock(struct usbd_bus *bus, kmutex_t **lock)
 }
 
 #ifdef RISCOS
+/*
+ * xHCI spec 4.3.3 / USB3 spec 8.9: the Slot Context Route String encodes
+ * the chain of downstream hub ports leading from the root hub down to
+ * this device, one nibble (1-15) per SuperSpeed hub tier crossed -- tier 1
+ * (the hub nearest the root) occupies the least significant nibble. It's
+ * 0 for a device attached directly to a root port. Only SS hubs below the
+ * root participate in SS routing; non-SS hubs never appear in this walk
+ * for a real SS device since a device can't be SuperSpeed if any hub
+ * between it and the root isn't.
+ */
+static uint32_t
+xhci_route_string(usbd_device_handle dev)
+{
+	uint8_t ports[5];
+	int n;
+	uint32_t route;
+	usbd_device_handle hub;
+
+	n = 0;
+	for (hub = dev; hub->myhub != NULL && hub->myhub->depth != 0 &&
+	    n < 5; hub = hub->myhub, n++) {
+		ports[n] = hub->powersrc->portno & 0xf;
+	}
+
+	route = 0;
+	for (int i = 0; i < n; i++)
+		route |= (uint32_t)ports[n - 1 - i] << (4 * i);
+	return route;
+}
+
 static usbd_status xhci_new_device_common(usbd_device_handle dev, bool bsr)
 {
 	struct xhci_softc * const sc = dev->bus->hci_private;
@@ -1931,7 +1961,9 @@ static usbd_status xhci_new_device_common(usbd_device_handle dev, bool bsr)
 	err = xhci_enable_slot(sc, &slot);
 	if (err)
 		return err;
-	err = xhci_init_slot(dev, slot, 0 /* USB3 route */, rhport);
+	err = xhci_init_slot(dev, slot,
+	    dev->speed == USB_SPEED_SUPER ? xhci_route_string(dev) : 0,
+	    rhport);
 	if (err)
 		return err;
 	xs = &sc->sc_slots[slot];
-- 
