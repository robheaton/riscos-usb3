From 06bcfcf695d76af86b706b047582e7a58e73fdbf Mon Sep 17 00:00:00 2001
From: Rob Heaton <rob@northwestlinux.co.uk>
Date: Tue, 29 Sep 2026 20:42:25 +0100
Subject: [PATCH 1/5] USB3: use bMaxBurst from the SS endpoint companion
 descriptor

xhci_configure_endpoint() hardcoded Max Burst Size to 0 in the endpoint
context. Use the bMaxBurst recorded by USBDriver from the endpoint's
SuperSpeed Endpoint Companion Descriptor; 0 when there is none, so
behaviour for non-SuperSpeed endpoints is unchanged.

Only the BRANCH_NHUSB code path (the one the Makefile builds) is changed.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 c/xhci | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/c/xhci b/c/xhci
index f321267..0061097 100644
--- a/c/xhci
+++ b/c/xhci
@@ -1113,6 +1113,11 @@ xhci_configure_endpoint(usbd_pipe_handle pipe)
 	const uint8_t xfertype = UE_GET_XFERTYPE(ed->bmAttributes);
 #ifdef BRANCH_NHUSB
 	uint32_t mps = UGETW(ed->wMaxPacketSize);
+	/* USB3 spec 9.6.7: burst count comes from the SS endpoint companion
+	 * descriptor, not the base endpoint descriptor; absent for non-SS
+	 * devices and for endpoint types that don't burst. */
+	uint32_t maxb = pipe->endpoint->ecomp ?
+	    pipe->endpoint->ecomp->bMaxBurst : 0;
 #endif
 	struct xhci_trb trb;
 	usbd_status err;
@@ -1149,7 +1154,7 @@ xhci_configure_endpoint(usbd_pipe_handle pipe)
 	cp[1] = htole32(
 	    XHCI_EPCTX_1_CERR_SET(3) |
 	    XHCI_EPCTX_1_EPTYPE_SET(xhci_ep_get_type(pipe->endpoint->edesc)) |
-	    XHCI_EPCTX_1_MAXB_SET(0) |
+	    XHCI_EPCTX_1_MAXB_SET(maxb) |
 	    XHCI_EPCTX_1_MAXP_SIZE_SET(UE_GET_SIZE(mps))
 	    );
 #else
@@ -1169,7 +1174,7 @@ xhci_configure_endpoint(usbd_pipe_handle pipe)
 	cp[1] = htole32(
 	    XHCI_EPCTX_1_CERR_SET(3) |
 	    XHCI_EPCTX_1_EPTYPE_SET(xhci_ep_get_type(pipe->endpoint->edesc)) |
-	    XHCI_EPCTX_1_MAXB_SET(0) |
+	    XHCI_EPCTX_1_MAXB_SET(maxb) |
 	    XHCI_EPCTX_1_MAXP_SIZE_SET(UE_GET_SIZE(mps))
 	    );
 #else
-- 
