+/*
+ * A physical root hub port pair exposes two xHCI logical port numbers:
+ * one under the USB2 (HS/FS/LS) protocol grouping, one under the USB3
+ * (SuperSpeed) grouping (xhci_init() parses these out as
+ * sc_hs_port_start/sc_ss_port_start via the extended capabilities). Only
+ * one side of a given pair is ever actually linked at a time. Root hub
+ * port emulation is keyed by a single logical port `index`; this picks
+ * whichever side currently shows a device connected so that a SuperSpeed
+ * device plugged into a root port is reported correctly instead of being
+ * silently read via its unconnected USB2 twin.
+ *
+ * Root-port-direct SS devices only: this does not attempt to make SS
+ * hubs behind a root port, or devices behind those hubs, aware of their
+ * SS-ness beyond what the generic USBDriver core already does once told
+ * the correct speed here.
+ */
+static int
+xhci_rhport_reg(struct xhci_softc *sc, int index)
+{
+	int ssport;
+
+	if (index >= 1 && index <= sc->sc_ss_port_count) {
+		ssport = XHCI_PORTSC(sc->sc_ss_port_start - 1 + index);
+		if (xhci_op_read_4(sc, ssport) & XHCI_PS_CCS)
+			return ssport;
+	}
+	return XHCI_PORTSC(sc->sc_hs_port_start - 1 + index);
+}
